{
  "openapi": "3.1.0",
  "info": {
    "title": "",
    "version": "1.0.0"
  },
  "paths": {
    "/aaa/users/v2": {
      "get": {
        "description": "Searches for team members by query.",
        "operationId": "UsersMgmtService_SearchUsers",
        "parameters": [
          {
            "description": "Team ID to search within. Optional on the /aaa/users/v2 routes, which bind no team in the path: omit it and the team of the API key making the call is used.",
            "in": "query",
            "name": "team_id",
            "required": false,
            "schema": {
              "description": "Team ID to search within. Optional on the /aaa/users/v2 routes, which bind no team in the path: omit it and the team of the API key making the call is used.",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Optional filter by username (partial match supported)",
            "in": "query",
            "name": "username",
            "required": false,
            "schema": {
              "description": "Optional filter by username (partial match supported)",
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "description": "Optional filter by user status (e.g., 'active', 'inactive')",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/UserStatus"
                }
              ],
              "description": "Optional filter by user status (e.g., 'active', 'inactive')"
            }
          },
          {
            "description": "Number of results per page",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "description": "Number of results per page",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Token for pagination to retrieve the next page of results",
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "description": "Token for pagination to retrieve the next page of results",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchUsersResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Team not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Search Users",
        "tags": [
          "Users Management Service"
        ]
      },
      "put": {
        "description": "Updates team members for the specified team.",
        "operationId": "UsersMgmtService_UpdateUsers",
        "parameters": [
          {
            "description": "Team ID containing the users to update. Optional on the /aaa/users/v2 routes, which bind no team in the path: omit it and the team of the API key making the call is used.",
            "in": "query",
            "name": "team_id",
            "required": false,
            "schema": {
              "description": "Team ID containing the users to update. Optional on the /aaa/users/v2 routes, which bind no team in the path: omit it and the team of the API key making the call is used.",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "List of users to update. Multiple users can be updated in a single request.",
                "items": {
                  "$ref": "#/components/schemas/UpdateUserRequest"
                },
                "minItems": 0,
                "type": "array"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateUsersResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "User not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Update Users",
        "tags": [
          "Users Management Service"
        ]
      },
      "post": {
        "description": "Adds members to the specified team.",
        "operationId": "UsersMgmtService_CreateUsers",
        "parameters": [
          {
            "description": "Team ID where the users will be created. Optional on the /aaa/users/v2 routes, which bind no team in the path: omit it and the team of the API key making the call is used.",
            "in": "query",
            "name": "team_id",
            "required": false,
            "schema": {
              "description": "Team ID where the users will be created. Optional on the /aaa/users/v2 routes, which bind no team in the path: omit it and the team of the API key making the call is used.",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "List of users to create. Multiple users can be created in a single request.",
                "items": {
                  "$ref": "#/components/schemas/CreateUserRequest"
                },
                "minItems": 0,
                "type": "array"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUsersResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Team not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "User already exists"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Create Users",
        "tags": [
          "Users Management Service"
        ]
      }
    },
    "/aaa/users/v2/{user_account_id}": {
      "get": {
        "description": "Returns the details of a specific team member.",
        "operationId": "UsersMgmtService_GetUser",
        "parameters": [
          {
            "description": "User account ID to retrieve",
            "in": "path",
            "name": "user_account_id",
            "required": true,
            "schema": {
              "description": "User account ID to retrieve",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Team ID to search within. Optional on the /aaa/users/v2 routes, which bind no team in the path: omit it and the team of the API key making the call is used.",
            "in": "query",
            "name": "team_id",
            "required": false,
            "schema": {
              "description": "Team ID to search within. Optional on the /aaa/users/v2 routes, which bind no team in the path: omit it and the team of the API key making the call is used.",
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "User not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Get User",
        "tags": [
          "Users Management Service"
        ]
      }
    },
    "/aaa/users/v2:updateStatuses": {
      "patch": {
        "description": "Updates the active status of multiple team members.",
        "operationId": "UsersMgmtService_UpdateUsersStatuses",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request to activate or revoke (deactivate) one or more users within a team. This operation changes the user status to either Active (enables access) or Inactive (disables access).",
                "properties": {
                  "status": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/UserStatus"
                      }
                    ],
                    "description": "New status for the users: Active (enables system access) or Inactive (disables system access)"
                  },
                  "teamId": {
                    "description": "Team ID containing the users to update. Optional on the /aaa/users/v2 routes, which bind no team in the path: omit it and the team of the API key making the call is used.",
                    "format": "int64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "userAccountIds": {
                    "description": "List of user account IDs to update. All users will be set to the same status.",
                    "items": {
                      "description": "List of user account IDs to update. All users will be set to the same status.",
                      "format": "int64",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "minItems": 0,
                    "type": "array"
                  },
                  "userIds": {
                    "description": "Stable ids of the users to update, as an alternative to `userAccountIds`. All users will be set to the same status. Mutually exclusive with `userAccountIds`: set exactly one of the two.",
                    "items": {
                      "description": "Stable ids of the users to update, as an alternative to `userAccountIds`. All users will be set to the same status. Mutually exclusive with `userAccountIds`: set exactly one of the two.",
                      "maxLength": 255,
                      "minLength": 1,
                      "pattern": "^[\\s\\S]+$",
                      "type": "string"
                    },
                    "maxItems": 1000,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "title": "UpdateUserStatusRequest",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateUsersStatusesResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "User not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Activate/Revoke Users",
        "tags": [
          "Users Management Service"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccessType": {
        "title": "AccessType",
        "required": [
          "accessType"
        ],
        "type": "object",
        "oneOf": [
          {
            "required": [
              "permanentAccess"
            ],
            "type": "object"
          },
          {
            "required": [
              "temporaryAccess"
            ],
            "type": "object"
          },
          {
            "type": "object",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "permanentAccess"
                  ],
                  "type": "object"
                },
                {
                  "required": [
                    "temporaryAccess"
                  ],
                  "type": "object"
                }
              ]
            }
          }
        ],
        "properties": {
          "accessType": {
            "minLength": 0,
            "type": "string",
            "description": "Type of access: 'permanent' or 'temporary'"
          },
          "permanentAccess": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PermanentAccess"
              }
            ],
            "description": "Permanent access configuration - user has indefinite access"
          },
          "temporaryAccess": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TemporaryAccess"
              }
            ],
            "description": "Temporary access configuration - user access expires at a specified time"
          }
        },
        "description": "Defines the access duration for a user. Can be either permanent (indefinite) or temporary (expires at a specific time).",
        "discriminator": {
          "propertyName": "accessType"
        },
        "externalDocs": {
          "url": ""
        }
      },
      "AllowedLoginMode": {
        "enum": [
          "ALLOWED_LOGIN_MODE_UNSPECIFIED",
          "ALLOWED_LOGIN_MODE_SSO",
          "ALLOWED_LOGIN_MODE_LOCAL"
        ],
        "type": "string"
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "onboardingMode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OnboardingMode"
              }
            ],
            "description": "Onboarding mode determines whether the user receives an invite link or is created without one"
          },
          "userTemplate": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserTemplate"
              }
            ],
            "description": "Template containing all user properties to set during creation"
          }
        }
      },
      "CreateUserResult": {
        "required": [
          "username"
        ],
        "type": "object",
        "properties": {
          "message": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[\\s\\S]+$",
            "type": "string",
            "description": "Human-readable detail about this outcome. Set where a status alone is not enough, such as `CREATE_USER_STATUS_FAILED`."
          },
          "status": {
            "$ref": "#/components/schemas/CreateUserStatus"
          },
          "user": {
            "allOf": [
              {
                "$ref": "#/components/schemas/rbac.v2.User"
              }
            ],
            "description": "Full details of the created user, as returned by GetUser. Absent when the outcome produced no user, such as an invited user, who has none until the invitation is accepted."
          },
          "userAccountId": {
            "minimum": 0,
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[\\s\\S]+$",
            "type": "string",
            "description": "Stable id of the user. Absent when the outcome produced no user, such as an invited user, who has none until the invitation is accepted."
          },
          "username": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[\\s\\S]+$",
            "type": "string",
            "description": "The username from the request this result belongs to"
          }
        },
        "externalDocs": {
          "url": ""
        }
      },
      "CreateUserStatus": {
        "enum": [
          "CREATE_USER_STATUS_UNSPECIFIED",
          "CREATE_USER_STATUS_CREATED",
          "CREATE_USER_STATUS_ALREADY_EXISTS",
          "CREATE_USER_STATUS_INVITED",
          "CREATE_USER_STATUS_ALREADY_INVITED",
          "CREATE_USER_STATUS_DOMAIN_NOT_ALLOWED",
          "CREATE_USER_STATUS_FAILED"
        ],
        "type": "string"
      },
      "CreateUsersResponse": {
        "title": "CreateUsersResponse",
        "type": "object",
        "properties": {
          "results": {
            "maxItems": 1000,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateUserResult"
            },
            "description": "Exactly one entry per user in the request, in request order. Each entry also echoes its `username`, so a caller can join on that instead of on position."
          }
        },
        "description": "Empty response indicating successful processing of all user creation and invitation requests. Ensure failures are returned via gRPC status codes.",
        "externalDocs": {
          "description": "Find out more about user management",
          "url": "https://coralogix.com/docs/user-guides/account-management/user-management/assign-user-roles-and-scopes-via-groups/"
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer",
            "description": "HTTP status code of the error (for example 400, 404, 500).",
            "format": "int32"
          },
          "message": {
            "maxLength": 4096,
            "minLength": 0,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Human-readable description of the error."
          }
        },
        "description": "Standard error response body returned for a failed request."
      },
      "FilterPathAndValues": {
        "title": "FilterPathAndValues",
        "required": [
          "path"
        ],
        "type": "object",
        "oneOf": [
          {
            "required": [
              "multipleValues"
            ],
            "type": "object"
          },
          {
            "required": [
              "filters"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "filters": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Filters"
              }
            ],
            "description": "The filters."
          },
          "multipleValues": {
            "$ref": "#/components/schemas/MultipleValues"
          },
          "path": {
            "minLength": 0,
            "type": "string",
            "examples": [
              "test"
            ]
          }
        },
        "description": "This data structure represents a filter path and values",
        "externalDocs": {
          "url": ""
        }
      },
      "Filters": {
        "title": "Filters",
        "required": [
          "pathAndValues"
        ],
        "type": "object",
        "properties": {
          "operator": {
            "allOf": [
              {
                "$ref": "#/components/schemas/v3.FilterOperator"
              }
            ],
            "examples": [
              "FILTER_OPERATOR_OR"
            ]
          },
          "pathAndValues": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterPathAndValues"
            }
          }
        },
        "description": "This data structure represents a filter",
        "externalDocs": {
          "url": ""
        }
      },
      "GetUserResponse": {
        "title": "GetUserResponse",
        "type": "object",
        "properties": {
          "user": {
            "allOf": [
              {
                "$ref": "#/components/schemas/rbac.v2.User"
              }
            ],
            "description": "Complete user details"
          }
        },
        "description": "Response containing the complete details of the requested user, including account information, status, login modes, and access configuration.",
        "externalDocs": {
          "description": "Find out more about user management",
          "url": "https://coralogix.com/docs/user-guides/account-management/user-management/assign-user-roles-and-scopes-via-groups/"
        }
      },
      "MultipleValues": {
        "type": "object",
        "properties": {
          "matcher": {
            "$ref": "#/components/schemas/events.v3.FilterMatcher"
          },
          "values": {
            "minItems": 0,
            "type": "array",
            "items": {
              "minLength": 0,
              "type": "string"
            }
          }
        }
      },
      "OnboardingMode": {
        "enum": [
          "ONBOARDING_MODE_UNSPECIFIED",
          "ONBOARDING_MODE_INVITE_LINK",
          "ONBOARDING_MODE_NO_INVITE"
        ],
        "type": "string",
        "description": "Onboarding mode."
      },
      "PermanentAccess": {
        "title": "PermanentAccess",
        "type": "object",
        "additionalProperties": false,
        "description": "User with permanent access. The user's access does not expire and remains active until manually revoked or deactivated.",
        "externalDocs": {
          "url": ""
        }
      },
      "SearchUsersResponse": {
        "title": "SearchUsersResponse",
        "type": "object",
        "properties": {
          "nextPageToken": {
            "minimum": 0,
            "type": "integer",
            "description": "Token for the next page of results. Empty if no more pages available.",
            "format": "int64"
          },
          "totalCount": {
            "minimum": 0,
            "type": "integer",
            "description": "Total number of users matching the search criteria across all pages",
            "format": "int64"
          },
          "users": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/rbac.v2.User"
            },
            "description": "List of users matching the search criteria"
          }
        },
        "description": "Response containing a paginated list of users matching the search criteria, along with pagination tokens and total count.",
        "externalDocs": {
          "description": "Find out more about user management",
          "url": "https://coralogix.com/docs/user-guides/account-management/user-management/assign-user-roles-and-scopes-via-groups/"
        }
      },
      "TemporaryAccess": {
        "title": "TemporaryAccess",
        "type": "object",
        "properties": {
          "expireAt": {
            "minLength": 0,
            "type": "string",
            "description": "Timestamp when the user's temporary access will expire. After this time, the user will no longer be able to access the system.",
            "format": "date-time",
            "examples": [
              "2021-01-01T00:00:00.000Z"
            ]
          }
        },
        "description": "User with temporary access. The user's access will automatically expire at the specified timestamp.",
        "externalDocs": {
          "url": ""
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "userAccountId": {
            "minimum": 0,
            "type": "integer",
            "description": "User account ID of the user to update",
            "format": "int64"
          },
          "userId": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[\\s\\S]+$",
            "type": "string",
            "description": "Stable id of the user to update, as an alternative to `userAccountId`. Mutually exclusive with `userAccountId`: exactly one must be set."
          },
          "userTemplate": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserTemplate"
              }
