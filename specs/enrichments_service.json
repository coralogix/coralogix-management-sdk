      "CompanyEnrichmentSettings": {
        "type": "object",
        "properties": {
          "enrichmentAmountLimit": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "description": "Maximum number of enrichment rules allowed for the account.",
            "format": "int64",
            "examples": [
              5
            ]
          },
          "enrichmentsInUse": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "description": "Number of enrichment rules currently in use by the account.",
            "format": "int64",
            "examples": [
              2
            ]
          },
          "queryOnlyRowLimit": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "description": "Row count above which a custom enrichment becomes query-only (usable in queries but not applied at ingest time). Defaults to 10000.",
            "format": "int64",
            "examples": [
              10000
            ]
          },
          "queryOnlySizeLimitBytes": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[0-9]+$",
            "type": "string",
            "description": "File size in bytes above which a custom enrichment becomes query-only (usable in queries but not applied at ingest time). Defaults to 524288 (512 KiB).",
            "examples": [
              "524288"
            ]
          },
          "rowLimit": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "description": "Maximum number of rows allowed in a custom enrichment file. Defaults to 150000.",
            "format": "int64",
            "examples": [
              150000
            ]
          },
          "sizeLimitBytes": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[0-9]+$",
            "type": "string",
            "description": "Maximum custom enrichment file size in bytes. Defaults to 20971520 (20 MiB).",
            "examples": [
              "20971520"
            ]
          }
        },
        "description": "Company enrichment settings.",
        "externalDocs": {
          "url": ""
        }
