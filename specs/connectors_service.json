              "description": "The not found ids."
            },
            "description": "The not found ids.",
            "examples": [
              [
                "connector-id-3"
              ]
            ]
          }
        },
        "description": "Response containing the requested connectors and any IDs not found",
        "externalDocs": {
          "description": "Find out more about notification center",
          "url": "https://coralogix.com/docs/user-guides/notification-center/introduction/welcome/"
        }
      },
      "Connector": {
        "title": "Connector",
        "required": [
          "name",
          "type"
        ],
        "type": "object",
        "properties": {
          "configOverrides": {
            "maxItems": 100,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityTypeConfigOverrides"
            },
            "description": "The config overrides."
          },
          "connectorConfig": {
            "$ref": "#/components/schemas/ConnectorConfig"
          },
          "createTime": {
            "description": "The create time. Set by the server; a value sent by the client is ignored.",
            "format": "date-time",
            "minLength": 0,
            "readOnly": true,
            "type": "string",
            "x-coralogix-presence": true
          },
          "description": {
            "maxLength": 5000,
            "minLength": 0,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Human-readable description.",
            "examples": [
              "Connector for team notifications"
            ]
          },
          "diagnostics": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Diagnostics"
              }
            ],
            "deprecated": true
          },
          "id": {
            "description": "Unique identifier.",
            "examples": [
              "a16e24c8-4db2-4abf-ba3c-c9e1fc35a3b9"
            ],
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "type": "string",
            "x-coralogix-presence": true
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[\\s\\S]+$",
            "type": "string",
            "description": "Display name.",
            "examples": [
              "My Slack Connector"
            ]
          },
          "resolvedConnectorConfig": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConnectorConfig"
              }
            ],
            "description": "Read-only full effective config, including backend auto-resolved fields. Set by the server; a value sent by the client is ignored.",
            "readOnly": true
          },
          "teamId": {
            "description": "Team identifier. Set by the server; a value sent by the client is ignored.",
            "examples": [
              12345
            ],
            "format": "int64",
            "maximum": 4294967295,
            "minimum": 1,
            "readOnly": true,
            "type": "integer",
            "x-coralogix-presence": true
          },
          "type": {
            "$ref": "#/components/schemas/notification_center.ConnectorType"
          },
          "updateTime": {
            "description": "Timestamp of the last update. Set by the server; a value sent by the client is ignored.",
            "format": "date-time",
            "minLength": 0,
            "readOnly": true,
            "type": "string",
            "x-coralogix-presence": true
          }
        },
        "description": "A connector configuration for sending notifications",
        "externalDocs": {
          "description": "Find out more about notification center",
          "url": "https://coralogix.com/docs/user-guides/notification-center/introduction/welcome/"
        }
      },
      "ConnectorConfig": {
        "title": "Connector Config",
