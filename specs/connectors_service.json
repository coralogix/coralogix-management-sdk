    "/notifications/notification-center/v1/connectors:initialize": {
      "post": {
        "description": "MCP-safe connector creation: creates the connector when no secret is required, otherwise returns a pre-fill deep link to the UI. Never accepts secrets.",
        "operationId": "ConnectorsService_InitializeConnector",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request to initialize a new connector. Never accepts secret values: creates the connector when no secret is required, otherwise returns a pre-fill link to finish setup in the Coralogix UI.",
                "properties": {
                  "connector": {
                    "$ref": "#/components/schemas/Connector"
                  }
                },
                "title": "Initialize Connector Request",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "isCreated": false,
                  "link": "https://my-team.coralogix.com/notification-center/connectors/create?type=service_now&name=Prod&config.serviceUrl=https://acme.service-now.com",
                  "reason": "INITIALIZE_CONNECTOR_REDIRECT_REASON_SECRETS_NOT_ACCEPTED"
                },
                "schema": {
                  "$ref": "#/components/schemas/InitializeConnectorResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Initialize a Connector",
        "tags": [
          "Connectors service"
        ]
      }
    },
    "/notifications/notification-center/v1/connectors:initializeUpdate": {
      "post": {
        "description": "MCP-safe partial connector update: applies non-sensitive changes and retains stored secrets, otherwise returns a pre-fill link. Never accepts secrets; response contains no config.",
        "operationId": "ConnectorsService_InitializeConnectorUpdate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request to update an existing connector, identified by `connector.id`, without sending secret values. `connector.type` is required and must match the stored type. Secret values are never accepted: if the request contains one, nothing is applied and the response carries a link to finish the update in the Coralogix UI. Stored secrets are always kept. An empty `name` or `description` keeps the stored value. `connectorConfig` fields are merged, so fields you leave out keep their stored values. `configOverrides` replaces the stored overrides: an override you leave out, and any non-secret field you leave out of an override you send, is removed. To keep the current overrides, send back the `configOverrides` returned by `GetConnectorSummary`.",
                "properties": {
                  "connector": {
                    "$ref": "#/components/schemas/Connector"
                  }
                },
                "title": "Initialize Connector Update Request",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "isUpdated": false,
                  "link": "https://my-team.coralogix.com/notification-center/connectors?id=a16e24c8-4db2-4abf-ba3c-c9e1fc35a3b9",
                  "reason": "INITIALIZE_CONNECTOR_REDIRECT_REASON_SECRETS_NOT_ACCEPTED"
                },
                "schema": {
                  "$ref": "#/components/schemas/InitializeConnectorUpdateResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Connector not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Initialize a Connector Update",
        "tags": [
          "Connectors service"
        ]
      }
    }
