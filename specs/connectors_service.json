        ],
        "type": "object",
        "properties": {
          "configOverrides": {
            "maxItems": 100,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityTypeConfigOverrides"
            },
            "description": "The config overrides."
          },
          "connectorConfig": {
            "$ref": "#/components/schemas/ConnectorConfig"
          },
          "createTime": {
            "description": "The create time. Set by the server; a value sent by the client is ignored.",
            "format": "date-time",
