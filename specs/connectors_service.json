          "connectors": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Connector"
            },
            "description": "The connectors."
          },
          "notFoundIds": {
            "maxItems": 800,
            "minItems": 0,
            "type": "array",
            "items": {
