      "post": {
        "description": "Creates a new team group.",
        "operationId": "GroupsMgmtService_CreateTeamGroup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request to create a new team group with specified name, description, roles, users, and optional scope filters. Can be associated with a specific team or the authenticated team.",
                "properties": {
                  "description": {
                    "description": "Human-readable description of the team group.",
                    "minLength": 0,
                    "type": "string",
                    "x-coralogix-presence": true
                  },
                  "externalId": {
                    "description": "External identifier for the group, used when the group is managed by an external identity provider.",
                    "minLength": 0,
                    "type": "string",
                    "x-coralogix-presence": true
                  },
                  "groupType": {
                    "$ref": "#/components/schemas/GroupType",
                    "x-coralogix-presence": true
                  },
                  "name": {
                    "description": "Unique display name for the new team group.",
                    "minLength": 0,
                    "type": "string"
                  },
                  "roleId": {
                    "description": "Identifier of the role to assign to this group.",
                    "format": "int64",
                    "minimum": 0,
                    "type": "integer",
                    "x-coralogix-presence": true
                  },
                  "roleName": {
                    "description": "Name of the role to assign to this group, as an alternative to `roleId`. Resolved against this team's custom roles and the global built-in roles. Matching is case-insensitive. The response reports the resolved role's id and canonical name. Mutually exclusive with `roleId`: setting both is rejected.",
                    "maxLength": 255,
                    "minLength": 1,
                    "pattern": "^[\\s\\S]*$",
                    "type": "string",
                    "x-coralogix-presence": true
                  },
                  "scope": {
                    "$ref": "#/components/schemas/v2.Scope"
                  },
                  "teamId": {
                    "description": "Team to associate the group with. If not set, uses the authenticated team.",
                    "format": "int64",
                    "minimum": 0,
                    "type": "integer",
                    "x-coralogix-presence": true
                  },
                  "userIds": {
                    "description": "The user ids.",
                    "items": {
                      "description": "The user ids.",
                      "minLength": 0,
                      "type": "string"
                    },
                    "minItems": 0,
                    "type": "array"
                  }
                },
                "title": "CreateTeamGroupRequest",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTeamGroupResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Team group already exists"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
