{
  "openapi": "3.1.0",
  "info": {
    "title": "",
    "version": "1.0.0"
  },
  "paths": {
    "/aaa/identity/v1/whoami": {
      "get": {
        "tags": [
          "Identity Service"
        ],
        "summary": "Who am I",
        "description": "Returns the team, and where available the user, that the presented credentials authenticate as. Takes no parameters: the identity is derived entirely from the `Authorization` header. Authenticating with an API key resolves a team but no user, so `username` is absent in that case.",
        "operationId": "IdentityService_WhoAmI",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmIResponse"
                },
                "example": {
                  "teamId": 1234567,
                  "teamName": "my-team",
                  "teamUrl": "https://my-team.app.coralogix.com"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The authenticated team no longer exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "description": "Standard error response body returned for a failed request.",
        "type": "object",
        "properties": {
          "code": {
            "description": "HTTP status code of the error (for example 400, 404, 500).",
            "type": "integer",
            "format": "int32",
            "minimum": 100,
            "maximum": 599
          },
          "message": {
            "description": "Human-readable description of the error.",
            "type": "string",
            "pattern": "^[\\s\\S]*$",
            "minLength": 0,
            "maxLength": 4096
          }
        }
      },
      "FilterPathAndValues": {
        "externalDocs": {
          "url": ""
        },
        "title": "FilterPathAndValues",
        "description": "This data structure represents a filter path and values",
        "type": "object",
        "properties": {
          "filters": {
            "description": "The filters.",
            "allOf": [
              {
                "$ref": "#/components/schemas/Filters"
              }
            ]
          },
          "multipleValues": {
            "$ref": "#/components/schemas/MultipleValues"
          },
          "path": {
            "type": "string",
            "minLength": 0
          }
        },
        "required": [
          "path"
        ],
        "oneOf": [
          {
            "type": "object",
            "required": [
              "multipleValues"
            ]
          },
          {
            "type": "object",
            "required": [
              "filters"
            ]
          }
        ]
      },
      "Filters": {
        "externalDocs": {
          "url": ""
        },
        "title": "Filters",
        "description": "This data structure represents a filter",
        "type": "object",
        "properties": {
          "operator": {
            "allOf": [
              {
                "$ref": "#/components/schemas/v3.FilterOperator"
              }
            ]
          },
          "pathAndValues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterPathAndValues"
            },
            "minItems": 0
          }
        },
        "required": [
          "pathAndValues"
        ]
      },
      "MultipleValues": {
        "type": "object",
        "properties": {
          "matcher": {
            "$ref": "#/components/schemas/events.v3.FilterMatcher"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 0
            },
            "minItems": 0
          }
        }
      },
      "WhoAmIResponse": {
        "externalDocs": {
          "url": ""
        },
        "title": "WhoAmIResponse",
        "description": "The team, and where available the user, that the presented credentials authenticate as.",
        "type": "object",
        "properties": {
          "teamId": {
            "description": "Identifier of the team the credentials belong to.",
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 4294967295
          },
          "teamName": {
            "description": "Display name of the team.",
            "type": "string",
            "pattern": "^[\\s\\S]*$",
            "minLength": 1,
            "maxLength": 255
          },
          "teamUrl": {
            "description": "Full web-app URL of the team. Absent when the team has no URL slug configured.",
            "type": "string",
            "pattern": "^https://[^\\s/?#]+[^\\s]*$",
            "minLength": 1,
            "maxLength": 2048
          },
          "username": {
            "description": "Username of the authenticated user. Absent when authenticating with an API key, which carries no user identity.",
            "type": "string",
            "pattern": "^[\\s\\S]*$",
            "minLength": 1,
            "maxLength": 320
          }
        },
        "required": [
          "teamId",
          "teamName"
        ]
      },
      "events.v3.FilterMatcher": {
        "type": "string",
        "enum": [
          "FILTER_MATCHER_TEXT_OR_UNSPECIFIED",
          "FILTER_MATCHER_REGEXP"
        ]
      },
      "v3.FilterOperator": {
        "description": "Filter operator.",
        "type": "string",
        "enum": [
          "FILTER_OPERATOR_AND_OR_UNSPECIFIED",
          "FILTER_OPERATOR_OR"
        ]
      }
    }
  }
}