  "paths": {
    "/fleet-management/configuration-groups/v1": {
      "post": {
        "description": "Creates a fleet-manager configuration group.",
        "operationId": "ConfigurationGroupService_CreateConfigurationGroup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request to create a fleet-manager configuration group.",
                "properties": {
                  "group": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/ConfigurationGroupCreate"
                      }
                    ],
                    "description": "Configuration group to create."
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "group": {
                    "description": "Collector configuration group for production.",
                    "families": [],
                    "id": "01975ed4-9c1a-7b3f-8d4e-426614174000",
                    "name": "Production collectors",
                    "priorityOrder": 100,
                    "tags": [
                      "production"
                    ]
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/CreateConfigurationGroupResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Configuration group already exists"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Create configuration group",
        "tags": [
          "Fleet Manager Configuration Groups"
        ],
        "x-stability": "preview"
      }
    },
