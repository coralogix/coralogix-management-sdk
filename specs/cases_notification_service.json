{
  "openapi": "3.1.0",
  "info": {
    "title": "",
    "version": "1.0.0"
  },
  "paths": {
    "/cases/notifications/v1/deliveries": {
      "post": {
        "description": "Retrieve notification delivery records for one or more cases, including routing, target, and outcome information.\n\nRequires the following permissions:\n- `case:Read`",
        "operationId": "CasesNotificationService_ListNotificationDeliveries",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request to retrieve notification delivery records for one or more cases.",
                "properties": {
                  "caseIds": {
                    "description": "Case IDs to retrieve notification deliveries for",
                    "examples": [
                      [
                        "3f166e9f-3c88-4af2-b52e-138f339dab3e",
                        "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                      ]
                    ],
                    "items": {
                      "description": "Case IDs to retrieve notification deliveries for",
                      "maxLength": 64,
                      "minLength": 1,
                      "pattern": "^[\\s\\S]*$",
                      "type": "string"
                    },
                    "maxItems": 1000,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "caseIds"
                ],
                "title": "List notification deliveries request",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListNotificationDeliveriesResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "List notification deliveries for cases",
        "tags": [
          "Cases notification service"
        ],
        "x-coralogixPermissions": [
          "case:Read"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CaseNotificationDeliveries": {
        "title": "Case notification deliveries",
        "required": [
          "notificationDeliveries"
        ],
        "type": "object",
        "properties": {
          "notificationDeliveries": {
            "maxItems": 1000,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationDelivery"
            },
            "description": "Notification deliveries for the case"
          }
        },
        "description": "Notification deliveries for a single case."
      },
      "ConnectorDetails": {
        "title": "Connector details",
        "required": [
          "connectorId",
          "connectorType",
          "connectorName"
        ],
        "type": "object",
        "properties": {
          "connectorId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "type": "string",
            "description": "Unique identifier of the connector",
            "examples": [
              "c1d2e3f4-5678-90ab-cdef-1234567890ab"
            ]
          },
          "connectorName": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Display name of the connector",
            "examples": [
              "Production Slack"
            ]
          },
          "connectorType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/v1.ConnectorType"
              }
            ],
            "description": "Type of the connector"
          }
        },
        "description": "Details of a notification connector."
      },
      "DeliveryAttempt": {
        "title": "Delivery attempt",
        "required": [
          "connector",
          "outcome"
        ],
        "type": "object",
        "properties": {
          "connector": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConnectorDetails"
              }
            ],
            "description": "The connector that the delivery was sent to"
          },
          "outcome": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeliveryOutcome"
              }
            ],
            "description": "Outcome of the delivery attempt"
          }
        },
        "description": "A single delivery attempt to a specific connector."
      },
      "DeliveryFailure": {
        "title": "Delivery failure",
        "required": [
          "errorMessage"
        ],
        "type": "object",
        "properties": {
          "errorMessage": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Error message describing the failure",
            "examples": [
              "Connection timeout after 30s"
            ]
          }
        },
        "description": "Failed delivery outcome with error details."
      },
      "DeliveryOutcome": {
        "title": "Delivery outcome",
        "type": "object",
        "oneOf": [
          {
            "required": [
              "success"
            ],
            "type": "object"
          },
          {
            "required": [
              "failure"
            ],
            "type": "object"
          },
          {
            "type": "object",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "success"
                  ],
                  "type": "object"
                },
                {
                  "required": [
                    "failure"
                  ],
                  "type": "object"
                }
              ]
            }
          }
        ],
        "properties": {
          "failure": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeliveryFailure"
              }
            ],
            "description": "Delivery failed"
          },
          "success": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeliverySuccess"
              }
            ],
            "description": "Delivery succeeded"
          }
        },
        "description": "Outcome of a notification delivery attempt."
      },
      "DeliverySuccess": {
        "title": "Delivery success",
        "type": "object",
        "properties": {
          "evidenceUrl": {
            "description": "URL to the delivered notification, if available (e.g. Slack message, ServiceNow record)",
            "examples": [
              "https://workspace.slack.com/archives/C01ABC23DEF/p1234567890123456"
            ],
            "maxLength": 2048,
            "minLength": 1,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "x-coralogix-presence": true
          }
        },
        "description": "Successful delivery outcome with an optional evidence URL."
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer",
            "description": "HTTP status code of the error (for example 400, 404, 500).",
            "format": "int32"
          },
          "message": {
            "maxLength": 4096,
            "minLength": 0,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Human-readable description of the error."
          }
        },
        "description": "Standard error response body returned for a failed request."
      },
      "FilterPathAndValues": {
        "title": "FilterPathAndValues",
        "required": [
          "path"
        ],
        "type": "object",
        "oneOf": [
          {
            "required": [
              "multipleValues"
            ],
            "type": "object"
          },
          {
            "required": [
              "filters"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "filters": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Filters"
              }
            ],
            "description": "The filters."
          },
          "multipleValues": {
            "$ref": "#/components/schemas/MultipleValues"
          },
          "path": {
            "minLength": 0,
            "type": "string",
            "examples": [
              "test"
            ]
          }
        },
        "description": "This data structure represents a filter path and values"
      },
      "Filters": {
        "title": "Filters",
        "required": [
          "pathAndValues"
        ],
        "type": "object",
        "properties": {
          "operator": {
            "allOf": [
              {
                "$ref": "#/components/schemas/v3.FilterOperator"
              }
            ],
            "examples": [
              "FILTER_OPERATOR_OR"
            ]
          },
          "pathAndValues": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterPathAndValues"
            }
          }
        },
        "description": "This data structure represents a filter"
      },
      "ListNotificationDeliveriesResponse": {
        "title": "List notification deliveries response",
        "required": [
          "deliveriesByCase"
        ],
        "type": "object",
        "properties": {
          "deliveriesByCase": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/CaseNotificationDeliveries"
            },
            "description": "Notification deliveries keyed by case ID"
          }
        },
        "description": "Response containing a list of notification delivery records for cases."
      },
      "MultipleValues": {
        "type": "object",
        "properties": {
          "matcher": {
            "$ref": "#/components/schemas/events.v3.FilterMatcher"
          },
          "values": {
            "minItems": 0,
            "type": "array",
            "items": {
              "minLength": 0,
              "type": "string"
            }
          }
        }
      },
      "NoNotificationCreatedResult": {
        "title": "No notification created result",
        "required": [
          "matchedRouters"
        ],
        "type": "object",
        "properties": {
          "matchedRouters": {
            "maxItems": 1000,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouterInfo"
            },
            "description": "Routers that matched the notification request"
          }
        },
        "description": "Indicates that routers matched but no notification was ultimately created."
      },
      "NoRouterMatchedResult": {
        "title": "No router matched result",
        "type": "object",
        "additionalProperties": false,
        "description": "Indicates that no router matched the notification request."
      },
      "NotificationDelivery": {
        "title": "Notification delivery",
        "required": [
          "timestamp"
        ],
        "type": "object",
        "oneOf": [
          {
            "required": [
              "noRouterMatched"
            ],
            "type": "object"
          },
          {
            "required": [
              "noNotificationCreated"
            ],
            "type": "object"
          },
          {
            "required": [
              "attempted"
            ],
            "type": "object"
          },
          {
            "type": "object",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "noRouterMatched"
                  ],
                  "type": "object"
                },
                {
                  "required": [
                    "noNotificationCreated"
                  ],
                  "type": "object"
                },
                {
                  "required": [
                    "attempted"
                  ],
                  "type": "object"
                }
              ]
            }
          }
        ],
        "properties": {
          "attempted": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RoutedDelivery"
              }
            ],
            "description": "Delivery was attempted through a router to one or more connectors"
          },
          "noNotificationCreated": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NoNotificationCreatedResult"
              }
            ],
            "description": "Routers matched but no notification was created"
          },
          "noRouterMatched": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NoRouterMatchedResult"
              }
            ],
            "description": "No router matched the notification request"
          },
          "requestNotificationId": {
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string",
            "description": "The notification request ID that triggered this delivery, used to correlate delivery outcomes with their originating requests",
            "examples": [
              "a1b2c3d4-5678-90ab-cdef-1234567890ab"
            ]
          },
          "timestamp": {
            "maxLength": 30,
            "minLength": 20,
            "type": "string",
            "description": "When the notification was triggered",
            "format": "date-time",
            "examples": [
              "2025-09-22T10:30:00.000Z"
            ]
          }
        },
        "description": "Delivery results for a single notification."
      },
      "RoutedDelivery": {
        "title": "Routed delivery",
        "required": [
          "router",
          "attempts"
        ],
        "type": "object",
        "properties": {
          "attempts": {
            "maxItems": 100,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeliveryAttempt"
            },
            "description": "Individual delivery attempts to connectors"
          },
          "router": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RouterInfo"
              }
            ],
            "description": "The router that handled the notification"
          }
        },
        "description": "Delivery attempts routed through a single router to one or more connectors."
      },
      "RouterInfo": {
        "title": "Router info",
        "required": [
          "routerId",
          "routerName"
        ],
        "type": "object",
        "properties": {
          "routerId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "type": "string",
            "description": "Unique identifier of the router",
            "examples": [
              "d4e5f678-90ab-cdef-1234-567890abcdef"
            ]
          },
          "routerName": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Display name of the router",
            "examples": [
              "Production alerts router"
            ]
          }
        },
        "description": "Information about a notification router."
      },
      "events.v3.FilterMatcher": {
        "enum": [
          "FILTER_MATCHER_TEXT_OR_UNSPECIFIED",
          "FILTER_MATCHER_REGEXP"
        ],
        "type": "string"
      },
      "v1.ConnectorType": {
        "enum": [
          "CONNECTOR_TYPE_UNSPECIFIED",
          "CONNECTOR_TYPE_SLACK",
          "CONNECTOR_TYPE_SERVICE_NOW",
          "CONNECTOR_TYPE_PAGER_DUTY",
          "CONNECTOR_TYPE_EMAIL",
          "CONNECTOR_TYPE_GENERIC_HTTPS",
          "CONNECTOR_TYPE_MICROSOFT_TEAMS"
        ],
        "type": "string",
        "description": "Connector type."
      },
      "v3.FilterOperator": {
        "enum": [
          "FILTER_OPERATOR_AND_OR_UNSPECIFIED",
          "FILTER_OPERATOR_OR"
        ],
        "type": "string",
        "description": "Filter operator."
      }
    }
  }
}