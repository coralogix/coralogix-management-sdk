            "minLength": 1,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Connector payload schema type."
          }
        }
      },
      "FailureReason": {
        "enum": [
          "FAILURE_REASON_UNSPECIFIED",
          "INVALID_TEMPLATE",
          "FIELD_NOT_FOUND",
          "TEMPLATE_EXCEEDS_MAX_LENGTH",
          "RENDERED_VALUE_EXCEEDS_MAX_LENGTH"
        ],
        "type": "string",
        "description": "Failure reason."
      },
      "FilterPathAndValues": {
        "title": "FilterPathAndValues",
        "required": [
          "path"
        ],
        "type": "object",
        "oneOf": [
          {
            "required": [
              "multipleValues"
            ],
            "type": "object"
          },
          {
            "required": [
              "filters"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "filters": {
