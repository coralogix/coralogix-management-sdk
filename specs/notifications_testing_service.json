                    "maxItems": 100,
                    "minItems": 0,
                    "type": "array"
                  },
                  "connectorId": {
                    "description": "The connector id.",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
                    "type": "string"
                  },
                  "entitySubType": {
                    "description": "Entity sub-type to use when testing the destination.",
                    "examples": [
                      "logsImmediateResolved"
                    ],
                    "maxLength": 100,
                    "minLength": 1,
                    "pattern": "^[\\s\\S]*$",
                    "type": "string"
                  },
                  "entityType": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/notification_center.EntityType"
                      }
                    ],
                    "examples": [
                      "ALERTS"
                    ]
                  },
                  "messageConfigFields": {
                    "description": "The message config fields.",
                    "items": {
                      "$ref": "#/components/schemas/notification_center.MessageConfigField"
                    },
                    "maxItems": 100,
                    "minItems": 0,
                    "type": "array"
                  },
                  "payloadType": {
                    "description": "Payload type to use when testing the destination.",
                    "examples": [
                      "default"
                    ],
                    "maxLength": 100,
                    "minLength": 1,
                    "pattern": "^[\\s\\S]*$",
                    "type": "string"
                  },
                  "presetId": {
                    "description": "The preset id.",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestDestinationResponse"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Test Destination",
        "tags": [
          "Notifications testing service"
        ]
      }
    },
