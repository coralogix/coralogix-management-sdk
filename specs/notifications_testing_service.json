      "TestResult": {
        "type": "object",
        "oneOf": [
          {
            "required": [
              "success"
            ],
            "type": "object"
          },
          {
            "required": [
              "failure"
            ],
            "type": "object"
          },
          {
            "type": "object",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "success"
                  ],
                  "type": "object"
                },
                {
                  "required": [
                    "failure"
                  ],
                  "type": "object"
                }
              ]
            }
          }
        ],
        "properties": {
          "failure": {
            "$ref": "#/components/schemas/TestResult.Failure"
          },
          "success": {
            "$ref": "#/components/schemas/TestResult.Success"
          }
        },
        "description": "Result of a notification test, either a success or failure.",
        "externalDocs": {
          "url": ""
        }
      },
      "TestResult.Failure": {
        "type": "object",
        "properties": {
          "message": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Human-readable message."
          },
          "statusCode": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer",
            "description": "The status code.",
            "format": "int64"
          }
        },
        "description": "Failure.",
        "externalDocs": {
          "url": ""
        }
      },
      "TestResult.Success": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "minLength": 0,
              "type": "string"
            },
            "description": "Metadata."
          }
        },
        "description": "Indicates the notification test succeeded.",
        "externalDocs": {
          "url": ""
        }
      },
      "TestRoutingConditionValidResponse": {
        "title": "Test Routing Condition Valid Response",
        "type": "object",
        "oneOf": [
          {
            "required": [
              "success"
            ],
            "type": "object"
          },
          {
            "required": [
              "failure"
            ],
            "type": "object"
          },
          {
            "type": "object",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "success"
                  ],
                  "type": "object"
                },
                {
                  "required": [
                    "failure"
                  ],
                  "type": "object"
                }
              ]
            }
          }
        ],
        "properties": {
          "failure": {
            "$ref": "#/components/schemas/TestRoutingConditionValidResponse.Failure"
          },
          "success": {
            "$ref": "#/components/schemas/TestRoutingConditionValidResponse.Success"
          }
        },
        "description": "Response which specifies condition evaluation result or error",
        "externalDocs": {
          "description": "Find out more about notification center",
          "url": "https://coralogix.com/docs/user-guides/notification-center/introduction/welcome/"
        }
      },
      "TestRoutingConditionValidResponse.Failure": {
        "type": "object",
        "properties": {
          "message": {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Human-readable message.",
            "examples": [
              "Invalid condition: condition should be rendered to a boolean value (true or false)"
            ]
          }
        },
        "description": "Indicates the routing condition is invalid, with a human-readable error message.",
        "externalDocs": {
          "url": ""
        }
      },
      "TestRoutingConditionValidResponse.Success": {
        "type": "object",
        "properties": {
          "result": {
            "type": "boolean",
            "description": "Result.",
            "examples": [
              true
            ]
          }
        },
        "description": "Indicates the routing condition is valid, with the evaluated result.",
        "externalDocs": {
          "url": ""
        }
      },
      "TestTemplateRenderResponse": {
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/TestTemplateRenderResult"
          }
        },
        "description": "Response containing the results of a notification template render test.",
        "externalDocs": {
          "url": ""
        }
      },
      "TestTemplateRenderResult": {
        "type": "object",
        "oneOf": [
          {
            "required": [
              "success"
            ],
            "type": "object"
          },
          {
            "required": [
              "failure"
            ],
            "type": "object"
          },
          {
            "type": "object",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "success"
