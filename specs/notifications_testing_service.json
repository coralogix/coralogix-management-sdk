            "$ref": "#/components/schemas/FailureReason"
          }
        },
        "description": "Indicates the template render test failed, with a message and failure reason.",
        "externalDocs": {
          "url": ""
        }
      },
      "TestTemplateRenderResult.Success": {
        "type": "object",
        "properties": {
          "renderedValue": {
            "maxLength": 50000,
            "minLength": 0,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "The rendered value.",
            "examples": [
