{
  "openapi": "3.1.0",
  "info": {
    "title": "",
    "version": "1.0.0"
  },
  "paths": {
    "/aaa/custom-roles/v1": {
      "get": {
        "description": "Returns all custom roles for the authenticated team.",
        "operationId": "RoleManagementService_ListCustomRoles",
        "parameters": [
          {
            "description": "Team identifier.",
            "in": "query",
            "name": "team_id",
            "required": false,
            "schema": {
              "description": "Team identifier.",
              "format": "int64",
              "minimum": 0,
              "type": "integer",
              "x-coralogix-presence": true
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListCustomRolesResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "List Custom Roles",
        "tags": [
          "Role Management Service"
        ]
      },
      "put": {
        "description": "Creates a new custom role.",
        "operationId": "RoleManagementService_CreateRole",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request for creating a custom role. A parent role is required, by id or by name: the service answers 400 without one.",
                "oneOf": [
                  {
                    "required": [
                      "parentRoleId"
                    ],
                    "type": "object"
                  },
                  {
                    "required": [
                      "parentRoleName"
                    ],
                    "type": "object"
                  }
                ],
                "properties": {
                  "description": {
                    "description": "Human-readable description. Omitting it is the same as the empty string.",
                    "minLength": 0,
                    "type": "string"
                  },
                  "name": {
                    "description": "Display name. Unique in the team: the service answers 409 for a name that another role of the team has.",
                    "minLength": 0,
                    "type": "string"
                  },
                  "parentRoleId": {
                    "description": "The parent role id.",
                    "format": "int64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "parentRoleName": {
                    "description": "The parent role name. It is case-sensitive: the service answers 400 for a name that no system role has.",
                    "minLength": 0,
                    "type": "string"
                  },
                  "permissions": {
                    "description": "List of permissions. Each must be a permission that the service knows, in any case, or the service answers 400. The service keeps the case that it was given. Permissions that differ only in case are one permission, and the service keeps the first in ASCII order. Omitting the list creates a role without permissions.",
                    "items": {
                      "description": "List of permissions. Each must be a permission that the service knows, in any case, or the service answers 400. The service keeps the case that it was given. Permissions that differ only in case are one permission, and the service keeps the first in ASCII order. Omitting the list creates a role without permissions.",
                      "minLength": 0,
                      "type": "string"
                    },
                    "minItems": 0,
                    "type": "array"
                  },
                  "teamId": {
                    "description": "Team identifier.",
                    "format": "int64",
                    "minimum": 0,
                    "type": "integer",
                    "x-coralogix-presence": true
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRoleResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Role already exists"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Create Role",
        "tags": [
          "Role Management Service"
        ]
      }
    },
    "/aaa/custom-roles/v1/{role_id}": {
      "get": {
        "description": "Returns the details of the specified custom role.",
        "operationId": "RoleManagementService_GetCustomRole",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCustomRoleResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Role not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Get Custom Role",
        "tags": [
          "Role Management Service"
        ]
      },
      "post": {
        "description": "Updates the specified custom role.",
        "operationId": "RoleManagementService_UpdateRole",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request for updating a custom role.",
                "properties": {
                  "newDescription": {
                    "description": "The new description. Omit to keep the description.",
                    "minLength": 0,
                    "type": "string",
                    "x-coralogix-presence": true
                  },
                  "newName": {
                    "description": "The new name. Omit to keep the name. The service answers 409 for a name that another role of the team has.",
                    "minLength": 0,
                    "type": "string",
                    "x-coralogix-presence": true
                  },
                  "newPermissions": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/v2.Permissions"
                      }
                    ],
                    "description": "Replaces the permissions of the role. Omit to keep them. An object without permissions removes every permission. The parent role cannot be changed."
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateRoleResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Role not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Update Role",
        "tags": [
          "Role Management Service"
        ]
      },
      "delete": {
        "description": "Deletes the custom role with the specified ID.",
        "operationId": "RoleManagementService_DeleteRole",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteRoleResponse"
                }
              }
            },
            "description": ""
          },
          "204": {
            "description": "Role deleted"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Role not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Delete Role",
        "tags": [
          "Role Management Service"
        ]
      },
      "parameters": [
        {
          "name": "role_id",
          "in": "path",
          "description": "The role id.",
          "required": true,
          "schema": {
            "minimum": 0,
            "type": "integer",
            "description": "The role id.",
            "format": "int64"
          }
        }
      ]
    },
    "/aaa/system-roles/v1": {
      "get": {
        "description": "Returns all built-in system roles.",
        "operationId": "RoleManagementService_ListSystemRoles",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListSystemRolesResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "List System Roles",
        "tags": [
          "Role Management Service"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRoleResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "minimum": 0,
            "type": "integer",
            "description": "Unique identifier.",
            "format": "int64"
          }
        },
        "description": "Response returned after successfully creating a custom role. It holds only the id of the new role: read the role with the get operation."
      },
      "CustomRole": {
        "required": [
          "roleId"
        ],
        "type": "object",
        "properties": {
          "description": {
            "minLength": 0,
            "type": "string",
            "description": "Human-readable description."
          },
          "name": {
            "minLength": 0,
            "type": "string",
            "description": "Display name. Unique in the team: the create and update operations answer 409 for a name that another role of the team has."
          },
          "parentRoleId": {
            "minimum": 0,
            "type": "integer",
            "description": "The parent role id.",
            "format": "int64"
          },
          "parentRoleName": {
            "minLength": 0,
            "type": "string",
            "description": "The parent role name."
          },
          "permissions": {
            "minItems": 0,
            "type": "array",
            "items": {
              "minLength": 0,
              "type": "string",
              "description": "List of permissions. The get operation returns the permissions that the role owns, in the case that they were written in. The list operation returns them together with the permissions of the parent role."
            },
            "description": "List of permissions. The get operation returns the permissions that the role owns, in the case that they were written in. The list operation returns them together with the permissions of the parent role."
          },
          "roleId": {
            "minimum": 0,
            "type": "integer",
            "description": "The role id.",
            "format": "int64"
          },
          "teamId": {
            "minimum": 0,
            "type": "integer",
            "description": "Team identifier. The team of the credential, when the create operation was called without one.",
            "format": "int64"
          }
        },
        "description": "Custom role."
      },
      "DeleteRoleResponse": {
        "type": "object",
        "additionalProperties": false,
        "description": "Response returned after successfully deleting a custom role."
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer",
            "description": "HTTP status code of the error (for example 400, 404, 500).",
            "format": "int32"
          },
          "message": {
            "maxLength": 4096,
            "minLength": 0,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Human-readable description of the error."
          }
        },
        "description": "Standard error response body returned for a failed request."
      },
      "FilterPathAndValues": {
        "title": "FilterPathAndValues",
        "required": [
          "path"
        ],
        "type": "object",
        "oneOf": [
          {
            "required": [
              "multipleValues"
            ],
            "type": "object"
          },
          {
            "required": [
              "filters"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "filters": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Filters"
              }
            ],
            "description": "The filters."
          },
          "multipleValues": {
            "$ref": "#/components/schemas/MultipleValues"
          },
          "path": {
            "examples": [
              "test"
            ],
            "minLength": 0,
            "type": "string",
            "x-coralogix-presence": true
          }
        },
        "description": "This data structure represents a filter path and values"
      },
      "Filters": {
        "title": "Filters",
        "required": [
          "pathAndValues"
        ],
        "type": "object",
        "properties": {
          "operator": {
            "allOf": [
              {
                "$ref": "#/components/schemas/v3.FilterOperator"
              }
            ],
            "examples": [
              "FILTER_OPERATOR_OR"
            ]
          },
          "pathAndValues": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterPathAndValues"
            }
          }
        },
        "description": "This data structure represents a filter"
      },
      "GetCustomRoleResponse": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/CustomRole"
          }
        },
        "description": "Response containing the details of a custom role."
      },
      "ListCustomRolesResponse": {
        "type": "object",
        "properties": {
          "roles": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomRole"
            },
            "description": "List of roles."
          }
        },
        "description": "Response containing a list of custom roles."
      },
      "ListSystemRolesResponse": {
        "type": "object",
        "properties": {
          "roles": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SystemRole"
            },
            "description": "List of roles."
          }
        },
        "description": "Response containing a list of system roles."
      },
      "MultipleValues": {
        "type": "object",
        "properties": {
          "matcher": {
            "$ref": "#/components/schemas/events.v3.FilterMatcher"
          },
          "values": {
            "minItems": 0,
            "type": "array",
            "items": {
              "minLength": 0,
              "type": "string"
            }
          }
        }
      },
      "SystemRole": {
        "type": "object",
        "properties": {
          "description": {
            "minLength": 0,
            "type": "string",
            "description": "Human-readable description."
          },
          "name": {
            "minLength": 0,
            "type": "string",
            "description": "Display name."
          },
          "permissions": {
            "minItems": 0,
            "type": "array",
            "items": {
              "minLength": 0,
              "type": "string",
              "description": "List of permissions."
            },
            "description": "List of permissions."
          },
          "roleId": {
            "minimum": 0,
            "type": "integer",
            "description": "The role id.",
            "format": "int64"
          }
        }
      },
      "UpdateRoleResponse": {
        "type": "object",
        "additionalProperties": false,
        "description": "Response returned after successfully updating a custom role."
      },
      "events.v3.FilterMatcher": {
        "enum": [
          "FILTER_MATCHER_TEXT_OR_UNSPECIFIED",
          "FILTER_MATCHER_REGEXP"
        ],
        "type": "string"
      },
      "v2.Permissions": {
        "type": "object",
        "properties": {
          "permissions": {
            "minItems": 0,
            "type": "array",
            "items": {
              "minLength": 0,
              "type": "string",
              "description": "List of permissions."
            },
            "description": "List of permissions."
          }
        },
        "description": "Permissions."
      },
      "v3.FilterOperator": {
        "enum": [
          "FILTER_OPERATOR_AND_OR_UNSPECIFIED",
          "FILTER_OPERATOR_OR"
        ],
        "type": "string",
        "description": "Filter operator."
      }
    }
  }
}