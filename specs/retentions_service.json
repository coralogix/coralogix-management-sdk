  "paths": {
    "/dataengine/retention-tags/v1": {
      "get": {
        "description": "Returns all available retention tags.",
        "operationId": "RetentionsService_GetRetentions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRetentionsResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Get Retentions",
        "tags": [
          "Retentions Service"
        ]
      },
      "post": {
        "description": "Creates a new retention tag.",
        "operationId": "RetentionsService_UpdateRetentions",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "This data structure is used to update retentions",
                "properties": {
                  "retentionUpdateElements": {
                    "description": "List of retention tag updates to apply.",
                    "items": {
                      "$ref": "#/components/schemas/RetentionUpdateElement"
                    },
                    "minItems": 0,
                    "type": "array"
                  }
                },
                "required": [
                  "retentionUpdateElements"
                ],
                "title": "Update Retentions Request",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateRetentionsResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Update Retentions",
        "tags": [
          "Retentions Service"
        ]
      }
    },
    "/dataengine/retention-tags/v1/activate": {
      "post": {
        "description": "Activates the specified retention tags.",
        "operationId": "RetentionsService_ActivateRetentions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivateRetentionsResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Activate Retentions",
        "tags": [
          "Retentions Service"
        ]
      }
    },
    "/dataengine/retention-tags/v1/enabled": {
      "get": {
        "description": "Returns the enabled retention tags for the team.",
        "operationId": "RetentionsService_GetRetentionsEnabled",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRetentionsEnabledResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Get Retentions Enabled",
        "tags": [
          "Retentions Service"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ActivateRetentionsResponse": {
        "title": "Activate Retentions Response",
        "type": "object",
        "properties": {
          "activateRetentions": {
            "description": "List of retentions to activate.",
            "examples": [
              true
            ],
            "type": "boolean",
            "x-coralogix-presence": true
          }
        },
        "description": "This data structure is obtained after setting the active status of retentions",
        "externalDocs": {
          "description": "Find out more about archives",
          "url": "https://coralogix.com/docs/user-guides/data-flow/s3-archive/connect-s3-archive/"
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer",
            "description": "HTTP status code of the error (for example 400, 404, 500).",
            "format": "int32"
          },
          "message": {
            "maxLength": 4096,
            "minLength": 0,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Human-readable description of the error."
          }
        },
        "description": "Standard error response body returned for a failed request."
      },
      "FilterPathAndValues": {
        "title": "FilterPathAndValues",
        "required": [
          "path"
        ],
        "type": "object",
        "oneOf": [
          {
            "required": [
              "multipleValues"
            ],
            "type": "object"
          },
          {
            "required": [
              "filters"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "filters": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Filters"
              }
            ],
            "description": "The filters."
          },
          "multipleValues": {
            "$ref": "#/components/schemas/MultipleValues"
          },
          "path": {
            "examples": [
              "test"
            ],
            "minLength": 0,
            "type": "string",
            "x-coralogix-presence": true
          }
        },
        "description": "This data structure represents a filter path and values"
      },
      "Filters": {
        "title": "Filters",
        "required": [
          "pathAndValues"
        ],
        "type": "object",
        "properties": {
          "operator": {
            "allOf": [
              {
                "$ref": "#/components/schemas/v3.FilterOperator"
              }
            ],
            "examples": [
              "FILTER_OPERATOR_OR"
            ]
          },
          "pathAndValues": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterPathAndValues"
            }
          }
        },
        "description": "This data structure represents a filter"
      },
      "GetRetentionsEnabledResponse": {
        "title": "Get Retentions Enabled Response",
        "type": "object",
        "properties": {
          "enableTags": {
            "description": "The enable tags.",
            "type": "boolean",
            "x-coralogix-presence": true
          }
        },
        "description": "This data structure is obtained when retrieving the active status of retentions",
        "externalDocs": {
          "description": "Find out more about archives",
          "url": "https://coralogix.com/docs/user-guides/data-flow/s3-archive/connect-s3-archive/"
        }
      },
      "GetRetentionsResponse": {
        "type": "object",
        "properties": {
          "retentions": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/archive.v1.Retention"
            },
            "description": "The retentions."
          }
        },
        "description": "Response containing the current data retention settings."
      },
      "MultipleValues": {
        "type": "object",
        "properties": {
          "matcher": {
            "$ref": "#/components/schemas/events.v3.FilterMatcher"
          },
          "values": {
            "minItems": 0,
            "type": "array",
            "items": {
              "minLength": 0,
              "type": "string"
            }
          }
        }
      },
      "RetentionUpdateElement": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Unique identifier.",
            "minLength": 0,
            "type": "string",
            "x-coralogix-presence": true
          },
          "name": {
            "description": "Display name.",
            "minLength": 0,
            "type": "string",
            "x-coralogix-presence": true
          }
        }
      },
      "UpdateRetentionsResponse": {
        "title": "Update Retentions Response",
        "required": [
          "retentions"
        ],
        "type": "object",
        "properties": {
          "retentions": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/archive.v1.Retention"
            },
            "description": "The retentions."
          }
        },
        "description": "This data structure is obtained after updating retentions",
        "externalDocs": {
          "description": "Find out more about archives",
          "url": "https://coralogix.com/docs/user-guides/data-flow/s3-archive/connect-s3-archive/"
        }
      },
      "archive.v1.Retention": {
        "title": "Retention",
        "type": "object",
        "properties": {
          "editable": {
            "description": "The editable.",
            "type": "boolean",
            "x-coralogix-presence": true
          },
          "id": {
            "description": "Unique identifier.",
            "minLength": 0,
            "type": "string",
            "x-coralogix-presence": true
          },
          "name": {
            "description": "Display name.",
            "minLength": 0,
            "type": "string",
            "x-coralogix-presence": true
          },
          "order": {
            "description": "Sort order.",
            "format": "int32",
            "type": "integer",
            "x-coralogix-presence": true
          }
        },
        "description": "This data structure represents a retention",
        "externalDocs": {
          "description": "Find out more about archives",
          "url": "https://coralogix.com/docs/user-guides/data-flow/s3-archive/connect-s3-archive/"
        }
      },
      "events.v3.FilterMatcher": {
        "enum": [
          "FILTER_MATCHER_TEXT_OR_UNSPECIFIED",
          "FILTER_MATCHER_REGEXP"
        ],
        "type": "string"
      },
      "v3.FilterOperator": {
        "enum": [
          "FILTER_OPERATOR_AND_OR_UNSPECIFIED",
          "FILTER_OPERATOR_OR"
        ],
        "type": "string",
        "description": "Filter operator."
      }
    }
  }
}