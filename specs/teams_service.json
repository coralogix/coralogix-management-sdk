  "components": {
    "schemas": {
      "CreateTeamInOrgResponse": {
        "type": "object",
        "properties": {
          "teamId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/v2.TeamId"
              }
            ],
            "description": "Identifier of the created team."
          }
        },
        "description": "Response containing the identifier of the created team."
      },
      "DeleteTeamResponse": {
        "type": "object",
        "additionalProperties": false,
        "description": "Empty response returned after deleting a team."
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer",
            "description": "HTTP status code of the error (for example 400, 404, 500).",
            "format": "int32"
          },
          "message": {
            "maxLength": 4096,
            "minLength": 0,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Human-readable description of the error."
          }
        },
        "description": "Standard error response body returned for a failed request."
      },
      "FilterPathAndValues": {
        "title": "FilterPathAndValues",
        "required": [
          "path"
        ],
        "type": "object",
        "oneOf": [
          {
            "required": [
              "multipleValues"
            ],
            "type": "object"
          },
          {
            "required": [
              "filters"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "filters": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Filters"
              }
            ],
            "description": "The filters."
          },
          "multipleValues": {
            "$ref": "#/components/schemas/MultipleValues"
          },
          "path": {
            "minLength": 0,
            "type": "string",
            "examples": [
              "test"
            ]
          }
        },
        "description": "This data structure represents a filter path and values"
      },
      "Filters": {
        "title": "Filters",
        "required": [
          "pathAndValues"
        ],
        "type": "object",
        "properties": {
          "operator": {
            "allOf": [
              {
                "$ref": "#/components/schemas/v3.FilterOperator"
              }
            ],
            "examples": [
              "FILTER_OPERATOR_OR"
            ]
          },
          "pathAndValues": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterPathAndValues"
            }
          }
        },
        "description": "This data structure represents a filter"
      },
      "GetTeamResponse": {
        "type": "object",
        "properties": {
          "dailyQuota": {
            "type": "number",
            "description": "Daily quota assigned to the team, in quota units per day.",
            "format": "double"
          },
          "retention": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "description": "Retention period of the team's data, in days.",
            "format": "int32"
          },
          "teamId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/v2.TeamId"
              }
            ],
            "description": "Identifier of the team."
          },
          "teamName": {
            "maxLength": 255,
            "minLength": 0,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Display name of the team."
          }
        },
        "description": "Response containing the requested team."
      },
      "ListTeamsResponse": {
        "type": "object",
        "properties": {
          "defaultTeam": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ListTeamsResponse.TeamInfo"
              }
            ],
            "description": "The organization's default team."
          },
          "teams": {
            "maxItems": 10000,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListTeamsResponse.TeamInfo"
            },
            "description": "Every team in the organization, including the default team."
          }
        },
        "description": "Response containing the teams in the calling user's organization."
      },
      "ListTeamsResponse.TeamInfo": {
        "type": "object",
        "properties": {
          "dailyQuota": {
            "type": "number",
            "description": "Daily quota assigned to the team, in quota units per day.",
            "format": "double"
          },
          "retention": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "description": "Retention period of the team's data, in days.",
            "format": "int32"
          },
          "teamId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/v2.TeamId"
              }
            ],
            "description": "The team id."
          },
          "teamName": {
            "maxLength": 255,
            "minLength": 0,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Display name of the team."
          }
        },
        "description": "A team and the quota and retention settings assigned to it."
      },
      "MultipleValues": {
        "type": "object",
        "properties": {
          "matcher": {
            "$ref": "#/components/schemas/events.v3.FilterMatcher"
          },
          "values": {
            "minItems": 0,
            "type": "array",
            "items": {
              "minLength": 0,
              "type": "string"
            }
          }
        }
      },
      "UpdateTeamResponse": {
        "type": "object",
        "additionalProperties": false,
        "description": "Empty response returned after updating a team."
      },
      "events.v3.FilterMatcher": {
        "enum": [
          "FILTER_MATCHER_TEXT_OR_UNSPECIFIED",
          "FILTER_MATCHER_REGEXP"
        ],
        "type": "string"
      },
      "v2.TeamId": {
        "type": "object",
        "properties": {
          "id": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer",
            "description": "Unique team identifier.",
            "format": "int64"
          }
        },
        "description": "Team id."
      },
      "v3.FilterOperator": {
        "enum": [
          "FILTER_OPERATOR_AND_OR_UNSPECIFIED",
          "FILTER_OPERATOR_OR"
        ],
        "type": "string",
        "description": "Filter operator."
      }
    }
  }
