            "description": "Internal server error"
          }
        },
        "summary": "List teams",
        "tags": [
          "Teams Service"
        ]
      },
      "post": {
        "deprecated": true,
        "description": "Deprecated. Creates a team in the calling user's organization and returns its identifier.",
        "operationId": "TeamService_CreateTeamInOrg",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Request to create a team in the calling user's organization.",
                "properties": {
                  "dailyQuota": {
                    "description": "Daily quota to assign to the new team, in quota units per day. Defaults to 0.01 when omitted.",
                    "format": "double",
                    "type": "number",
                    "x-coralogix-presence": true
                  },
                  "teamAdminsEmail": {
                    "description": "Email addresses of the users to add to the new team as administrators.",
                    "items": {
                      "description": "Email addresses of the users to add to the new team as administrators.",
                      "maxLength": 320,
                      "minLength": 1,
                      "pattern": "^[^@\\s]+@[^@\\s]+$",
                      "type": "string"
                    },
                    "maxItems": 100,
                    "minItems": 0,
                    "type": "array"
                  },
                  "teamName": {
                    "description": "Display name of the team to create.",
                    "maxLength": 255,
                    "minLength": 1,
                    "pattern": "^[\\s\\S]*$",
                    "type": "string"
                  }
                },
                "required": [
                  "teamName"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "teamId": {
                    "id": 1002
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/CreateTeamInOrgResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A team with the same name already exists"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Create team",
        "tags": [
          "Teams Service"
        ]
      }
    },
