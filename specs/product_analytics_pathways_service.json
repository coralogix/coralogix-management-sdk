{
  "openapi": "3.1.0",
  "info": {
    "title": "",
    "version": "1.0.0"
  },
  "paths": {
    "/product-analytics/pathways/v1": {
      "get": {
        "description": "Lists saved pathways, one page at a time, ordered by updatedAt descending, then by id descending. totalSize is the exact number of pathways that match app_names. Returns 412 (FAILED_PRECONDITION) with \"Product Analytics is not enabled for this team. A team admin can enable it in Coralogix.\" when Product Analytics is off for the team.\n\nRequires the following permissions:\n- `product-analytics:Read`",
        "operationId": "PathwaysService_ListSavedPathways",
        "parameters": [
          {
            "description": "Maximum number of pathways to return. 0 uses the default of 20. A value above 500 is lowered to 500. A negative value returns 400.",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "description": "Maximum number of pathways to return. 0 uses the default of 20. A value above 500 is lowered to 500. A negative value returns 400.",
              "format": "int32",
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The nextPageToken of the previous response. Empty for the first page. The token is opaque, valid for 15 minutes, and tied to the app_names of the request that returned it. A token that is expired, from another query, or malformed returns 400: \"pageToken belongs to a different query or has expired. Send the request again without pageToken.\"",
            "in": "query",
            "name": "page_token",
            "required": false,
            "schema": {
              "description": "The nextPageToken of the previous response. Empty for the first page. The token is opaque, valid for 15 minutes, and tied to the app_names of the request that returned it. A token that is expired, from another query, or malformed returns 400: \"pageToken belongs to a different query or has expired. Send the request again without pageToken.\"",
              "maxLength": 1024,
              "minLength": 0,
              "pattern": "^[\\s\\S]*$",
              "type": "string"
            }
          },
          {
            "description": "Returns only pathways of these RUM applications. Repeat the parameter for each application, for example app_names=web-shop&app_names=docs. Omit to return pathways of every application.",
            "in": "query",
            "name": "app_names",
            "required": false,
            "schema": {
              "description": "Returns only pathways of these RUM applications. Repeat the parameter for each application, for example app_names=web-shop&app_names=docs. Omit to return pathways of every application.",
              "items": {
                "description": "Returns only pathways of these RUM applications. Repeat the parameter for each application, for example app_names=web-shop&app_names=docs. Omit to return pathways of every application.",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^[\\s\\S]*$",
                "type": "string"
              },
              "maxItems": 100,
              "minItems": 0,
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "nextPageToken": "",
                  "pathways": [
                    {
                      "appName": "web-shop",
                      "createdAt": "2026-11-16T10:00:00.000Z",
                      "direction": "PATHWAY_DIRECTION_AFTER",
                      "filters": [],
                      "id": "44",
                      "name": "After cart",
                      "owner": "dana@example.com",
                      "pagesCount": 5,
                      "timeRange": {
                        "fixed": {
                          "fromTimestampMs": "1763251200000",
                          "toTimestampMs": "1763337600000"
                        }
                      },
                      "topN": 20,
                      "updatedAt": "2026-11-16T10:00:00.000Z",
                      "version": 1,
                      "view": "/cart"
                    }
                  ],
                  "totalSize": 1
                },
                "schema": {
                  "$ref": "#/components/schemas/ListSavedPathwaysResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "412": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Product Analytics is not enabled for this team"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "List pathways",
        "tags": [
          "Product Analytics Pathways Service"
        ],
        "x-coralogixPermissions": [
          "product-analytics:Read"
        ]
      },
      "post": {
        "description": "Creates a saved pathway and returns the stored pathway, with version 1. Returns 412 (FAILED_PRECONDITION) with \"Product Analytics is not enabled for this team. A team admin can enable it in Coralogix.\" when Product Analytics is off for the team.\n\nRequires the following permissions:\n- `product-analytics:Manage`",
        "operationId": "PathwaysService_CreateSavedPathway",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Pathway field values for a create.",
                "properties": {
                  "appName": {
                    "description": "RUM application the pathway belongs to. Cannot be changed after creation.",
                    "maxLength": 1024,
                    "minLength": 1,
                    "pattern": "^[\\s\\S]*$",
                    "type": "string"
                  },
                  "direction": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/PathwayDirection"
                      }
                    ],
                    "default": "PATHWAY_DIRECTION_AFTER",
                    "description": "Whether the paths show the pages after or before view. Omitted or PATHWAY_DIRECTION_UNSPECIFIED uses PATHWAY_DIRECTION_AFTER."
                  },
                  "filters": {
                    "description": "Session filters of the pathway.",
                    "items": {
                      "$ref": "#/components/schemas/ViewFilter"
                    },
                    "maxItems": 100,
                    "minItems": 0,
                    "type": "array",
                    "x-coralogix-collection": "set"
                  },
                  "name": {
                    "description": "Display name of the pathway. Must not be empty. Does not have to be unique.",
                    "maxLength": 1024,
                    "minLength": 1,
                    "pattern": "^[\\s\\S]*$",
                    "type": "string"
                  },
                  "pagesCount": {
                    "default": 5,
                    "description": "Number of pages after or before view in each path. Omitted uses 5.",
                    "format": "int32",
                    "maximum": 2147483647,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "timeRange": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/ViewTimeRange"
                      }
                    ],
                    "description": "Time range of the pathway."
                  },
                  "topN": {
                    "default": 20,
                    "description": "Number of paths shown, most common first. Omitted uses 20.",
                    "format": "int32",
                    "maximum": 2147483647,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "view": {
                    "description": "View (page) the paths are traced from.",
                    "maxLength": 1024,
                    "minLength": 1,
                    "pattern": "^[\\s\\S]*$",
                    "type": "string"
                  }
                },
                "required": [
                  "appName",
                  "name",
                  "view",
                  "timeRange"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "appName": "web-shop",
                  "createdAt": "2026-11-16T10:00:00.000Z",
                  "direction": "PATHWAY_DIRECTION_AFTER",
                  "filters": [],
                  "id": "44",
                  "name": "After cart",
                  "owner": "dana@example.com",
                  "pagesCount": 5,
                  "timeRange": {
                    "fixed": {
                      "fromTimestampMs": "1763251200000",
                      "toTimestampMs": "1763337600000"
                    }
                  },
                  "topN": 20,
                  "updatedAt": "2026-11-16T10:00:00.000Z",
                  "version": 1,
                  "view": "/cart"
                },
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SavedPathway"
                    }
                  ],
                  "description": "The created pathway."
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "412": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Product Analytics is not enabled for this team"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Create pathway",
        "tags": [
          "Product Analytics Pathways Service"
        ],
        "x-coralogixPermissions": [
          "product-analytics:Manage"
        ]
      }
    },
    "/product-analytics/pathways/v1/{id}": {
      "get": {
        "description": "Gets a saved pathway by ID. Returns 412 (FAILED_PRECONDITION) with \"Product Analytics is not enabled for this team. A team admin can enable it in Coralogix.\" when Product Analytics is off for the team.\n\nRequires the following permissions:\n- `product-analytics:Read`",
        "operationId": "PathwaysService_GetSavedPathway",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "appName": "web-shop",
                  "createdAt": "2026-11-16T10:00:00.000Z",
                  "direction": "PATHWAY_DIRECTION_AFTER",
                  "filters": [],
                  "id": "44",
                  "name": "After cart",
                  "owner": "dana@example.com",
                  "pagesCount": 5,
                  "timeRange": {
                    "fixed": {
                      "fromTimestampMs": "1763251200000",
                      "toTimestampMs": "1763337600000"
                    }
                  },
                  "topN": 20,
                  "updatedAt": "2026-11-16T10:00:00.000Z",
                  "version": 1,
                  "view": "/cart"
                },
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SavedPathway"
                    }
                  ],
                  "description": "The pathway."
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Pathway not found"
          },
          "412": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Product Analytics is not enabled for this team"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Get pathway",
        "tags": [
          "Product Analytics Pathways Service"
        ],
        "x-coralogixPermissions": [
          "product-analytics:Read"
        ]
      },
      "delete": {
        "description": "Deletes a saved pathway by ID. Returns 404 when the pathway does not exist. Returns 412 (FAILED_PRECONDITION) with \"Product Analytics is not enabled for this team. A team admin can enable it in Coralogix.\" when Product Analytics is off for the team.\n\nRequires the following permissions:\n- `product-analytics:Manage`",
        "operationId": "PathwaysService_DeleteSavedPathway",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {},
                "schema": {
                  "$ref": "#/components/schemas/DeleteSavedPathwayResponse"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Pathway not found"
          },
          "412": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Product Analytics is not enabled for this team"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Delete pathway",
        "tags": [
          "Product Analytics Pathways Service"
        ],
        "x-coralogixPermissions": [
          "product-analytics:Manage"
        ]
      },
      "patch": {
        "description": "Updates the fields listed in update_mask. Other fields are unchanged. A listed field that is omitted from the body is cleared or reset to its default. The last write wins, and version increases by 1. Returns the stored pathway. Returns 412 (FAILED_PRECONDITION) with \"Product Analytics is not enabled for this team. A team admin can enable it in Coralogix.\" when Product Analytics is off for the team.\n\nRequires the following permissions:\n- `product-analytics:Manage`",
        "operationId": "PathwaysService_UpdateSavedPathway",
        "parameters": [
          {
            "description": "Comma-separated JSON paths of the fields to update: name, view, direction, pagesCount, topN, timeRange, filters. snake_case names are also accepted. A listed field that is omitted from the body is cleared or reset to its default: direction resets to PATHWAY_DIRECTION_AFTER, pagesCount to 5, topN to 20, and filters becomes empty; name, view, and timeRange cannot be cleared: listing one without a value returns 400. Nested, unknown, immutable, and server-generated paths, and *, return 400. A listed field is replaced as a whole, a oneOf arm included.",
            "in": "query",
            "name": "update_mask",
            "required": true,
            "schema": {
              "description": "Comma-separated JSON paths of the fields to update: name, view, direction, pagesCount, topN, timeRange, filters. snake_case names are also accepted. A listed field that is omitted from the body is cleared or reset to its default: direction resets to PATHWAY_DIRECTION_AFTER, pagesCount to 5, topN to 20, and filters becomes empty; name, view, and timeRange cannot be cleared: listing one without a value returns 400. Nested, unknown, immutable, and server-generated paths, and *, return 400. A listed field is replaced as a whole, a oneOf arm included.",
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(,[A-Za-z_][A-Za-z0-9_]*)*$",
              "type": "string",
              "x-coralogix-presence": true
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Pathway field values for an update. Only fields listed in update_mask are applied.",
                "properties": {
                  "direction": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/PathwayDirection"
                      }
                    ],
                    "default": "PATHWAY_DIRECTION_AFTER",
                    "description": "Whether the paths show the pages after or before view. Clearing it or sending PATHWAY_DIRECTION_UNSPECIFIED resets it to PATHWAY_DIRECTION_AFTER."
                  },
                  "filters": {
                    "description": "Session filters of the pathway. Replaces the whole list.",
                    "items": {
                      "$ref": "#/components/schemas/ViewFilter"
                    },
                    "maxItems": 100,
                    "minItems": 0,
                    "type": "array",
                    "x-coralogix-collection": "set"
                  },
                  "name": {
                    "description": "Display name of the pathway. Must not be empty. Cannot be cleared.",
                    "maxLength": 1024,
                    "minLength": 1,
                    "pattern": "^[\\s\\S]*$",
                    "type": "string"
                  },
                  "pagesCount": {
                    "default": 5,
                    "description": "Number of pages after or before view in each path. Clearing it resets it to 5.",
                    "format": "int32",
                    "maximum": 2147483647,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "timeRange": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/ViewTimeRange"
                      }
                    ],
                    "description": "Time range of the pathway. Cannot be cleared."
                  },
                  "topN": {
                    "default": 20,
                    "description": "Number of paths shown, most common first. Clearing it resets it to 20.",
                    "format": "int32",
                    "maximum": 2147483647,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "view": {
                    "description": "View (page) the paths are traced from. Cannot be cleared.",
                    "maxLength": 1024,
                    "minLength": 1,
                    "pattern": "^[\\s\\S]*$",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "appName": "web-shop",
                  "createdAt": "2026-11-16T10:00:00.000Z",
                  "direction": "PATHWAY_DIRECTION_AFTER",
                  "filters": [],
                  "id": "44",
                  "name": "After cart",
                  "owner": "dana@example.com",
                  "pagesCount": 5,
                  "timeRange": {
                    "fixed": {
                      "fromTimestampMs": "1763251200000",
                      "toTimestampMs": "1763337600000"
                    }
                  },
                  "topN": 20,
                  "updatedAt": "2026-11-16T11:00:00.000Z",
                  "version": 2,
                  "view": "/cart"
                },
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SavedPathway"
                    }
                  ],
                  "description": "The updated pathway."
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Pathway not found"
          },
          "412": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Product Analytics is not enabled for this team"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Update pathway",
        "tags": [
          "Product Analytics Pathways Service"
        ],
        "x-coralogixPermissions": [
          "product-analytics:Manage"
        ]
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Pathway ID, a decimal number.",
          "required": true,
          "schema": {
            "maxLength": 19,
            "minLength": 1,
            "pattern": "^[1-9][0-9]{0,18}$",
            "type": "string",
            "description": "Pathway ID, a decimal number."
          }
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "BoolFilter": {
        "required": [
          "field",
          "value"
        ],
        "type": "object",
        "properties": {
          "field": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BoolFilterField"
              }
            ],
            "description": "Boolean field to filter on. BOOL_FILTER_FIELD_UNSPECIFIED is rejected.",
            "examples": [
              "BOOL_FILTER_FIELD_HAS_SESSION_REPLAY"
            ]
          },
          "value": {
            "description": "Value the field must have.",
            "type": "boolean",
            "x-coralogix-presence": true
          }
        },
        "description": "Filter on a boolean field."
      },
      "BoolFilterField": {
        "enum": [
          "BOOL_FILTER_FIELD_UNSPECIFIED",
          "BOOL_FILTER_FIELD_HAS_SESSION_REPLAY",
          "BOOL_FILTER_FIELD_HAS_SCREENSHOT",
          "BOOL_FILTER_FIELD_IS_RAGE_CLICK",
          "BOOL_FILTER_FIELD_IS_DEAD_CLICK"
        ],
        "type": "string",
        "description": "Session attribute with boolean values, for boolFilter."
      },
      "CalendarWindow": {
        "enum": [
          "CALENDAR_WINDOW_UNSPECIFIED",
          "CALENDAR_WINDOW_TODAY",
          "CALENDAR_WINDOW_YESTERDAY"
        ],
        "type": "string",
        "description": "Named calendar window. TODAY runs from local midnight to now, YESTERDAY covers the whole previous local day."
      },
      "DeleteSavedPathwayResponse": {
        "type": "object",
        "additionalProperties": false,
        "description": "Confirmation that the pathway was deleted."
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer",
            "description": "HTTP status code of the error (for example 400, 404, 500).",
            "format": "int32"
          },
          "message": {
            "maxLength": 4096,
            "minLength": 0,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Human-readable description of the error."
          }
        },
        "description": "Standard error response body returned for a failed request."
      },
      "FilterPathAndValues": {
        "title": "FilterPathAndValues",
        "required": [
          "path"
        ],
        "type": "object",
        "oneOf": [
          {
            "required": [
              "multipleValues"
            ],
            "type": "object"
          },
          {
            "required": [
              "filters"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "filters": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Filters"
              }
            ],
            "description": "The filters."
          },
          "multipleValues": {
            "$ref": "#/components/schemas/MultipleValues"
          },
          "path": {
            "examples": [
              "test"
            ],
            "minLength": 0,
            "type": "string",
            "x-coralogix-presence": true
          }
        },
        "description": "This data structure represents a filter path and values"
      },
      "Filters": {
        "title": "Filters",
        "required": [
          "pathAndValues"
        ],
        "type": "object",
        "properties": {
          "operator": {
            "allOf": [
              {
                "$ref": "#/components/schemas/v3.FilterOperator"
              }
            ],
            "examples": [
              "FILTER_OPERATOR_OR"
            ]
          },
          "pathAndValues": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterPathAndValues"
            }
          }
        },
        "description": "This data structure represents a filter"
      },
      "FixedTimeRange": {
        "required": [
          "fromTimestampMs",
          "toTimestampMs"
        ],
        "type": "object",
        "properties": {
          "fromTimestampMs": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[1-9][0-9]{0,18}$",
            "type": "string",
            "description": "Start of the range, in Unix milliseconds. Inclusive: events at exactly this time are in the range.",
            "examples": [
              "1763251200000"
            ]
          },
          "toTimestampMs": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[1-9][0-9]{0,18}$",
            "type": "string",
            "description": "End of the range, in Unix milliseconds. Exclusive: events at exactly this time are not in the range, so consecutive ranges can share a boundary.",
            "examples": [
              "1763337600000"
            ]
          }
        },
        "description": "Absolute time range, from inclusive to exclusive."
      },
      "ListSavedPathwaysResponse": {
        "type": "object",
