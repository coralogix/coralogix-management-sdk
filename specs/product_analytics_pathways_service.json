            "maxLength": 1024,
            "minLength": 0,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Token for the next page, valid for 15 minutes. Empty on the last page."
          },
          "pathways": {
            "maxItems": 500,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SavedPathway"
            },
            "description": "The pathways, ordered by updatedAt descending, then by id descending."
          },
          "totalSize": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "description": "Exact number of pathways that match app_names, across all pages.",
            "format": "int32"
          }
        },
        "description": "A page of saved pathways."
      },
      "MultipleValues": {
        "type": "object",
        "properties": {
          "matcher": {
            "$ref": "#/components/schemas/events.v3.FilterMatcher"
          },
          "values": {
            "minItems": 0,
            "type": "array",
            "items": {
              "minLength": 0,
              "type": "string"
            }
          }
        }
      },
      "NumericCondition": {
        "type": "object",
        "oneOf": [
          {
            "required": [
              "min"
            ],
            "type": "object"
          },
          {
            "required": [
              "max"
            ],
            "type": "object"
          },
          {
            "required": [
              "range"
            ],
            "type": "object"
          }
        ],
        "properties": {
          "max": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^-?[0-9]+$",
            "type": "string",
            "description": "Matches values less than or equal to max.",
            "examples": [
              "100"
            ]
          },
          "min": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^-?[0-9]+$",
            "type": "string",
            "description": "Matches values greater than or equal to min.",
            "examples": [
              "1"
            ]
          },
          "range": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NumericRange"
              }
            ],
            "description": "Matches values from lower to upper, both included."
          }
        },
        "description": "Numeric matching condition. Exactly one of min, max, or range is set."
      },
      "NumericFilter": {
        "required": [
          "field",
          "condition"
        ],
        "type": "object",
        "properties": {
          "condition": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NumericCondition"
              }
            ],
            "description": "Condition the field must match."
          },
          "field": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NumericFilterField"
              }
            ],
            "description": "Numeric field to filter on. NUMERIC_FILTER_FIELD_UNSPECIFIED is rejected.",
            "examples": [
              "NUMERIC_FILTER_FIELD_ERROR_COUNT"
            ]
          }
        },
        "description": "Filter on a numeric field."
      },
      "NumericFilterField": {
        "enum": [
          "NUMERIC_FILTER_FIELD_UNSPECIFIED",
          "NUMERIC_FILTER_FIELD_ERROR_COUNT",
          "NUMERIC_FILTER_FIELD_ACTION_COUNT",
          "NUMERIC_FILTER_FIELD_LONG_TASK_COUNT",
          "NUMERIC_FILTER_FIELD_CRASH_COUNT",
          "NUMERIC_FILTER_FIELD_RESOURCE_COUNT",
          "NUMERIC_FILTER_FIELD_SCROLL_DEPTH_PERCENTAGE",
          "NUMERIC_FILTER_FIELD_VIEWPORT_WIDTH",
          "NUMERIC_FILTER_FIELD_VIEWPORT_HEIGHT",
          "NUMERIC_FILTER_FIELD_RAGE_CLICK_COUNT",
          "NUMERIC_FILTER_FIELD_DEAD_CLICK_COUNT"
        ],
        "type": "string",
        "description": "Session attribute with numeric values, for numericFilter."
      },
      "NumericRange": {
        "required": [
          "lower",
          "upper"
        ],
        "type": "object",
        "properties": {
          "lower": {
            "description": "Lowest matching value, included. Must not be greater than upper.",
            "examples": [
              "1"
            ],
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^-?[0-9]+$",
            "type": "string",
            "x-coralogix-presence": true
          },
          "upper": {
            "description": "Highest matching value, included.",
            "examples": [
              "100"
            ],
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^-?[0-9]+$",
            "type": "string",
            "x-coralogix-presence": true
          }
        },
        "description": "Inclusive numeric range."
      },
      "PathwayDirection": {
        "enum": [
          "PATHWAY_DIRECTION_UNSPECIFIED",
          "PATHWAY_DIRECTION_AFTER",
          "PATHWAY_DIRECTION_BEFORE"
        ],
        "type": "string",
        "description": "Direction of a pathway. AFTER shows the pages visited after the view, where users go next. BEFORE shows the pages visited before it, where users came from."
      },
      "SavedPathway": {
        "required": [
          "id",
          "appName",
          "name",
          "view",
          "pagesCount",
          "topN",
          "direction",
          "timeRange",
          "createdAt",
          "updatedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "appName": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "RUM application the pathway belongs to."
          },
          "createdAt": {
            "description": "When the pathway was created. Set by the server.",
            "format": "date-time",
            "maxLength": 64,
            "minLength": 0,
            "readOnly": true,
            "type": "string",
            "x-coralogix-presence": true
          },
          "direction": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PathwayDirection"
              }
            ],
            "description": "Whether the paths show the pages after or before view.",
            "default": "PATHWAY_DIRECTION_AFTER"
          },
          "filters": {
            "description": "Session filters of the pathway. Empty when not set.",
            "items": {
              "$ref": "#/components/schemas/ViewFilter"
            },
            "maxItems": 100,
            "minItems": 0,
            "type": "array",
            "x-coralogix-collection": "set"
          },
          "id": {
            "maxLength": 19,
            "minLength": 1,
            "pattern": "^[1-9][0-9]{0,18}$",
            "type": "string",
            "description": "Pathway ID, a decimal number. Set by the server.",
            "readOnly": true
          },
          "name": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "Display name of the pathway. Does not have to be unique."
          },
          "owner": {
            "description": "User who created the pathway. Set by the server. Absent for pathways saved before owners were recorded.",
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[\\s\\S]*$",
            "readOnly": true,
            "type": "string",
            "x-coralogix-presence": true
          },
          "pagesCount": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Number of pages after or before view in each path.",
            "format": "int32",
            "default": 5
          },
          "timeRange": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ViewTimeRange"
              }
            ],
            "description": "Time range of the pathway."
          },
          "topN": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Number of paths shown, most common first.",
            "format": "int32",
            "default": 20
          },
          "updatedAt": {
            "description": "When the pathway was last updated, from the API or the Coralogix UI. Set by the server.",
            "format": "date-time",
            "maxLength": 64,
            "minLength": 0,
            "readOnly": true,
            "type": "string",
            "x-coralogix-presence": true
          },
          "version": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Version of the pathway. Set by the server: 1 on create, increased by 1 on every update, including updates made in the Coralogix UI.",
            "format": "int32",
            "readOnly": true
          },
          "view": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[\\s\\S]*$",
            "type": "string",
            "description": "View (page) the paths are traced from."
          }
        },
        "description": "A saved pathway of a RUM application: the paths sessions take to or from a page."
      },
